{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "accralife",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/dist/**",
      "tsconfig.json",
      "vite.config.ts",
      "package.json",
      "package-lock.json",
      "debug_browser.mjs",
      "*.py"
    ],
    "headers": [
      {
        "source": "**/*.@(wasm|jar|zip)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
