{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "accralife",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/dist/**",
      "tsconfig.json",
      "vite.config.ts",
      "package.json",
      "package-lock.json",
      "test_*.mjs",
      "inspect_*.mjs",
      "extract_*.mjs",
      "analyze_*.mjs",
      "debug_browser.mjs",
      "render_icon.mjs",
      "accralife_3d_*.png",
      "accra_clone_*.png",
      "test_*.png",
      "touch_*.png",
      "*.py"
    ],
    "headers": [
      {
        "source": "**/*.@(wasm|jar|zip)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
